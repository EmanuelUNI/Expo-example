{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MVI Lab (navegador manual)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "web-server",
      "noDebug": true,
      "templateFor": "lib",
      "toolArgs": [
        "--web-hostname=127.0.0.1",
        "--web-port=8080"
      ]
    }
  ]
}
